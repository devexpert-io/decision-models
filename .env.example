# Copia este archivo a .env y rellena las claves que tengas. Ninguna es obligatoria:
# cada ejemplo usa solo el proveedor que le pidas.

# Jev, de TypeSafe: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# OpenAI (Decisions API, en beta): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter: da acceso a Perplexity, Cloudflare, Liquid y el resto con la misma clave
OPENROUTER_API_KEY=

# Ollama en local (no necesita clave)
OLLAMA_URL=http://127.0.0.1:11434
